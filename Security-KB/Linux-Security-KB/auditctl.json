      "risk_level": "read_only_safe"
    },
    {
      "flag": "-l",
      "example_command": "auditctl -l",
      "purpose": "List all loaded audit rules.",
      "security_use_case": "Review active monitoring rules.",
      "threat_detected": "Missing rules, attacker evasion.",
      "risk_if_misused": "None.",
      "safe_followup": "Backup with -l > file.",
      "automation_safe": true,
      "risk_level": "read_only_safe"
    },
    {
      "flag": "-e",
