      "security_context": "Pre-change verification."
    },
    {
      "command": "auditctl -w /etc/passwd -p wa -k passwd_changes && auditctl -w /etc/shadow -p wa -k shadow_changes",
      "why_powerful": "Watch critical files with keys.",
      "security_context": "User account monitoring."
    },
    {
      "command": "auditctl -a always,exit -F arch=b64 -S execve -F auid!=0 -k privilege_escalation",
