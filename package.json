{
  "name": "heeba",
  "version": "1.3.0",
  "description": "Personal AI Terminal Companion",
  "main": "main.js",
  "bin": {
    "heeba": "./main.js"
  },
  "scripts": {
    "start": "node main.js",
    "dev": "node main.js",
    "build:exe": "pkg ."
  },
  "keywords": [
    "terminal",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "blessed": "^0.1.81",
    "html-to-text": "^9.0.5",
    "imapflow": "^1.2.18",
    "mailparser": "^3.9.6",
    "node-telegram-bot-api": "^0.67.0",
    "nodemailer": "^8.0.4",
    "pino": "^8.21.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.20.0"
  },
  "overrides": {},
  "pkg": {
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist",
    "icon": "assets/heeba.png",
    "assets": [
      "heeba.json",
      "credentials.json",
      "assets/**/*",
      "src/**/*",
      "node_modules/blessed/**/*"
    ]
  },
  "devDependencies": {
    "depcheck": "^1.4.7"
  }
}
